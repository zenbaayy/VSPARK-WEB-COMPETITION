# Public browser configuration only. Keep real project values in ignored .env.local.
# Never add Supabase service-role keys, OAuth client secrets, GitHub/Vercel tokens,
# SMTP credentials, or other server secrets to this file or any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional Google Drive Picker browser configuration; restrict API key by site and API.
VITE_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=YOUR_RESTRICTED_GOOGLE_API_KEY
VITE_GOOGLE_APP_ID=YOUR_GOOGLE_CLOUD_PROJECT_NUMBER
